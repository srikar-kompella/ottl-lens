{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OTTL",
  "scopeName": "source.ottl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.ottl"
    },
    "strings": {
      "name": "string.quoted.double.ottl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.ottl" }
      ]
    },
    "keywords": {
      "match": "\\b(where|and|or|not)\\b",
      "name": "keyword.control.ottl"
    },
    "constants": {
      "match": "\\b(true|false|nil)\\b",
      "name": "constant.language.ottl"
    },
    "functions": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "name": "entity.name.function.ottl"
    },
    "numbers": {
      "match": "\\b(0[xX][0-9a-fA-F]+|[0-9]+\\.?[0-9]*([eE][-+]?[0-9]+)?)\\b",
      "name": "constant.numeric.ottl"
    },
    "operators": {
      "match": "(==|!=|<=|>=|<|>|\\+|\\-|\\*|/)",
      "name": "keyword.operator.ottl"
    }
  }
}
